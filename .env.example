# Personal RAG Chatbot Configuration

# LLM Configuration (choose one)
# For OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# For local Ollama (alternative to OpenAI)
OLLAMA_HOST=http://localhost:11434
# For Docker Compose, use: http://ollama:11434
OLLAMA_MODEL=llama3.2

# API Security
X_API_KEY=your_secure_api_key_here
X_NON_BROWSER_KEY=your_non_browser_api_key_here

# CORS Settings (for web frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080