# Database — set individual parts OR set DATABASE_URL to override
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personal_chatbot
# DATABASE_URL=postgresql://user:pass@host:port/dbname  # overrides individual parts if set

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

LLM_PROVIDER=openrouter
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=deepseek-chat
ANTHROPIC_MAX_TOKENS=4096

EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIMENSIONS=768

# API security — /chat/* uses this key; /ingest/* and /admin/* use the JWT from /auth login
API_KEY=your_chat_client_key_here

# Geo enrichment (optional — skip silently if not set)
IPINFO_API_KEY=

# Ingestion limits
MAX_FILE_SIZE_MB=50
MAX_PAGES=500
DATA_DIR=data
EMBED_BATCH_SIZE=20

# Retrieval limits
CONTEXT_TOKEN_LIMIT=3000

# System prompts — markdown files loaded at startup (missing/empty file = app exits)
PROMPTS_DIR=prompts

# Generation resilience
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=0.5
LLM_STREAM_IDLE_TIMEOUT=45
LLM_CONTINUE_ON_TRUNCATION=true

# Chat rate limits (retries are free against CHAT_RATE_LIMIT, capped by CHAT_BURST_LIMIT)
CHAT_RATE_LIMIT=2/minute
CHAT_BURST_LIMIT=8/minute
CLIENT_MAX_RETRIES=2
CLIENT_RETRY_AFTER_MS=1200

# Retrieval (both default to local = 0 extra LLM calls per chat)
LLM_QUERY_EXPANSION=false
LLM_RERANK=false
MAX_QUERY_VECTORS=2
RERANK_RELEVANCE_WEIGHT=0.5
