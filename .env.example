# Database — set individual parts OR set DATABASE_URL to override
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personal_chatbot
# DATABASE_URL=postgresql://user:pass@host:port/dbname  # overrides individual parts if set

# LLM provider: "gemini" | "ollama"
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# API security — two separate keys, route-scoped
API_KEY=your_chat_client_key_here        # valid only on /chat/* routes
ADMIN_KEY=your_admin_key_here            # valid only on /ingest/* and /admin/* routes

# Geo enrichment (optional — skip silently if not set)
IPINFO_API_KEY=

# Ingestion limits
MAX_FILE_SIZE_MB=50
MAX_PAGES=500
DATA_DIR=data
EMBED_BATCH_SIZE=20

# Retrieval limits
CONTEXT_TOKEN_LIMIT=3000
